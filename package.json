{
  "name": "SplitEase",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "ultracite check",
    "dev": "tsx watch --env-file=.env.development src/index.ts",
    "fix": "ultracite fix",
    "prepare": "husky",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose --env-file=.env.development up -d",
    "db:down": "docker compose --env-file=.env.development down"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "ultracite": "8.2.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
